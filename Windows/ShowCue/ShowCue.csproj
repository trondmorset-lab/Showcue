<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>ShowCue</AssemblyName>
    <RootNamespace>ShowCue</RootNamespace>
    <!-- Versjonen hentes fra VERSION i roten av repoet (felles for Windows og Mac). -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../VERSION').Trim())</Version>
    <Product>ShowCue</Product>
    <Copyright>Copyright (C) 2026 Trond Morset. GNU GPL v3.</Copyright>
    <Description>Cue-basert avspillingsprogram for lyd, video, bilder, PDF, OSC og MIDI</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ShowCue.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lisensene følger med i selve programmet (vises under «Om ShowCue»). -->
    <EmbeddedResource Include="../../THIRD-PARTY-NOTICES.txt" LogicalName="ThirdPartyNotices.txt" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="License.txt" />
    <!-- Engelsk oversettelse av brukerflaten (felles for Windows og Mac). -->
    <EmbeddedResource Include="../../i18n/en.json" LogicalName="en.json" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\ShowCue.ico" />
    <Resource Include="Assets\logo-256.png" />
  </ItemGroup>

</Project>
