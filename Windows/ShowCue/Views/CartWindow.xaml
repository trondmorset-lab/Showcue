<Window x:Class="ShowCue.Views.CartWindow"
        Icon="pack://application:,,,/Assets/ShowCue.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ShowCue"
        Title="ShowCue – cart" Width="900" Height="620" MinWidth="360" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <local:CueColorBrushConverter x:Key="CueBrush" />
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <local:InverseBoolConverter x:Key="NotBool" />
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="Kolonner" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,0,8,0" />
                    <Slider x:Name="ColumnSlider" Width="140" Minimum="2" Maximum="8" IsSnapToTickEnabled="True" TickFrequency="1"
                            VerticalAlignment="Center" ValueChanged="ColumnSlider_ValueChanged" />
                    <TextBlock Text="{Binding Value, ElementName=ColumnSlider}" Width="20" Margin="6,0,16,0" VerticalAlignment="Center" />
                    <Button Content="⏸ / ▶" Padding="14,8" Margin="0,0,8,0" Click="Pause_Click" ToolTip="Pause / fortsett alt" />
                    <Button Style="{StaticResource DangerButton}" Content="STOPP ALT" Padding="18,8" Click="Panic_Click" />
                </StackPanel>
                <TextBlock Text="Trykk en knapp for å starte cuen, trykk igjen for å stoppe den. GO-markøren flyttes ikke."
                           Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                <ItemsControl x:Name="Tiles" Margin="8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid x:Name="TileGrid" Columns="4" Loaded="TileGrid_Loaded" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="6" Height="120" Padding="12,10" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    Click="Tile_Click" IsEnabled="{Binding Disabled, Converter={StaticResource NotBool}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource RunningRow}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Running}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Height="5" CornerRadius="2" Margin="0,0,0,8" Background="{Binding Color, Converter={StaticResource CueBrush}}" />
                                    <ProgressBar DockPanel.Dock="Bottom" Height="6" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                                                 Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}" />
                                    <DockPanel DockPanel.Dock="Top">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Hotkey}" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Wait}" FontWeight="Bold" />
                                        <TextBlock Text="{Binding Number}" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Playhead}" FontWeight="Bold" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="0,4" />
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="EmptyText" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="420" FontSize="14"
                       Text="Kryss av «Knapp i cart-vinduet» på en cue (eller gi den en hurtigtast), så dukker den opp her." />
        </Grid>
    </DockPanel>
</Window>
