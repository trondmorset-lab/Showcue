<Window x:Class="ShowCue.Views.SettingsWindow"
        Icon="pack://application:,,,/Assets/ShowCue.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ShowCue"
        Title="{local:T 'Innstillinger'}" Width="560" Height="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Panel}" Foreground="{DynamicResource Text}" FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <local:EnumTextConverter x:Key="EnumText" />
        <DataTemplate x:Key="EnumItem"><TextBlock Text="{Binding Converter={StaticResource EnumText}}" /></DataTemplate>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Faint}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="Page" TargetType="StackPanel">
            <Setter Property="Margin" Value="4,8,4,0" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16,12,16,16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{local:T 'Avbryt'}" Width="90" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="{local:T 'OK'}" Width="90" IsDefault="True" Click="Ok_Click" Background="{DynamicResource Playhead}" BorderBrush="{DynamicResource Playhead}" />
        </StackPanel>

        <TabControl>
            <!-- ================= LYD ================= -->
            <TabItem Header="{local:T 'Lyd'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource Page}">
                        <TextBlock Style="{StaticResource Label}" Text="{local:T 'Driver'}" />
                        <ComboBox x:Name="DriverBox" ItemsSource="{x:Static local:EnumValues.AudioDrivers}" ItemTemplate="{StaticResource EnumItem}"
                                  SelectionChanged="Driver_Changed" />

                        <StackPanel x:Name="WasapiPanel">
                            <TextBlock Style="{StaticResource Label}" Text="{local:T 'Lydenhet'}" />
                            <ComboBox x:Name="WasapiBox" DisplayMemberPath="Value" SelectedValuePath="Key" />
                            <TextBlock Style="{StaticResource Hint}" Text="{local:T 'Bruker enhetens egne kanaler og samplingsfrekvens. Nettverkslydkort i WDM-modus (f.eks. Dante Virtual Soundcard) og flerkanals USB-kort vises her.'}" />
                            <TextBlock Style="{StaticResource Label}" Text="{local:T 'Buffer (ms)'}" />
                            <TextBox x:Name="LatencyBox" />
                            <TextBlock Style="{StaticResource Hint}" Text="{local:T 'Lavere gir raskere respons på GO, men kan gi knaking. 40–80 ms er trygt for de fleste.'}" />
                        </StackPanel>

                        <StackPanel x:Name="AsioPanel">
                            <TextBlock Style="{StaticResource Label}" Text="{local:T 'ASIO-driver'}" />
                            <ComboBox x:Name="AsioBox" />
                            <TextBlock Style="{StaticResource Label}" Text="{local:T 'Maks antall kanaler'}" />
                            <TextBox x:Name="AsioChannelsBox" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{local:T 'Alle kanalene på lydkortet åpnes, opptil dette tallet (f.eks. 64 på et nettverkslydkort). Lydpatchen bestemmer hvilke kanaler lyden går til. Buffer og samplingsfrekvens for nettverkslydkort stilles i kortets eget kontrollprogram.'}" />
                            <TextBlock Style="{StaticResource Label}" Text="{local:T 'Ønsket samplingsfrekvens'}" />
                            <ComboBox x:Name="RateBox" />
                            <TextBlock Style="{StaticResource Hint}" Text="{local:T 'Hvis lydkortet ikke støtter valgt frekvens, brukes den første som virker (48, 44,1, 96 eller 88,2 kHz).'}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource Label}" Text="{local:T 'Forhåndslytting (bølgeformen) – egen lydenhet'}" Margin="0,18,0,3" />
                        <ComboBox x:Name="PreviewDeviceBox" DisplayMemberPath="Value" SelectedValuePath="Key" />
                        <TextBlock Style="{StaticResource Label}" Text="{local:T '…eller utgang i lydpatchen (første av to, 0 = cuens egne utganger)'}" />
                        <TextBox x:Name="PreviewBusBox" />
                        <TextBlock Style="{StaticResource Label}" Text="{local:T 'Live-inngang (for inngang-cuer)'}" Margin="0,18,0,3" />
                        <ComboBox x:Name="InputDeviceBox" DisplayMemberPath="Value" SelectedValuePath="Key" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="{local:T 'Velg hodetelefonene (f.eks. PC-ens egen utgang), eller en utgang i lydpatchen som går til en lyttehøyttaler. Da kan du lytte på cuer under forestillingen uten at det høres i salen. Med 0 og ingen enhet går lyttingen ut på cuens vanlige utganger.'}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= VIDEO ================= -->
            <TabItem Header="{local:T 'Video'}">
                <StackPanel Style="{StaticResource Page}">
                    <TextBlock Style="{StaticResource Label}" Text="{local:T 'Utgang for video, bilde og PDF'}" />
                    <ComboBox x:Name="ScreenBox" DisplayMemberPath="Value" SelectedValuePath="Key" />
                    <TextBlock Style="{StaticResource Hint}" Text="{local:T 'Velg projektoren/skjermen. «Vindu» gir et vanlig vindu, nyttig for å teste på én skjerm.'}" />
                </StackPanel>
            </TabItem>

            <!-- ================= OSC ================= -->
            <TabItem Header="{local:T 'OSC'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource Page}">
                        <CheckBox x:Name="OscEnabledBox" Content="{local:T 'Ta imot OSC (fjernstyring fra kontrollpaneler og lysbord, f.eks. Companion eller TouchOSC)'}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Label}" Text="{local:T 'UDP-port'}" />
                        <TextBox x:Name="OscPortBox" />
                        <TextBlock Style="{StaticResource Hint}" x:Name="OscAddressText" />
                        <TextBlock Style="{StaticResource Label}" Text="{local:T 'Kommandoer'}" Margin="0,14,0,3" />
                        <Border Background="{DynamicResource Panel2}" CornerRadius="4" Padding="10,8">
                            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource Text}" LineHeight="19"><Run Text="{local:T '/go'}" /><Run Foreground="{DynamicResource Muted}" Text="{local:T '               GO'}" /><LineBreak />
                                <Run Text="{local:T '/stop'}" /><Run Foreground="{DynamicResource Muted}" Text="{local:T '             stopp alt (med fade)'}" /><LineBreak />
                                <Run Text="{local:T '/panic'}" /><Run Foreground="{DynamicResource Muted}" Text="{local:T '            som Esc (2× = umiddelbart)'}" /><LineBreak />
                                <Run Text="{local:T '/hardstop'}" /><Run Foreground="{DynamicResource Muted}" Text="{local:T '         stopp alt umiddelbart'}" /><LineBreak />
                                <Run Text="{local:T '/next  /previous'}" /><Run Foreground="{DynamicResource Muted}" Text="{local:T '  flytt markøren'}" /><LineBreak />
                                <Run Text="{local:T '/playhead/12'}" /><Run Foreground="{DynamicResource Muted}" Text="{local:T '      sett markøren til cue 12'}" /><LineBreak />
                                <Run Text="{local:T '/cue/12/start'}" /><Run Foreground="{DynamicResource Muted}" Text="{local:T '     start cue 12'}" /><LineBreak />
                                <Run Text="{local:T '/cue/12/stop'}" /><Run Foreground="{DynamicResource Muted}" Text="{local:T '      stopp cue 12'}" /><LineBreak />
                                <Run Text="{local:T '/cue/12/go'}" /><Run Foreground="{DynamicResource Muted}" Text="{local:T '        markør til 12 + GO'}" /><LineBreak />
                                <Run Text="{local:T '/hotkey/F1'}" /><Run Foreground="{DynamicResource Muted}" Text="{local:T '        som å trykke F1'}" /></TextBlock>
                        </Border>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="{local:T 'Argument 0 ignoreres (knapp sluppet). Windows-brannmuren spør første gang – tillat ShowCue på private nettverk.'}" />

                        <Rectangle Height="1" Fill="{DynamicResource Line}" Margin="0,18,0,10" />
                        <TextBlock Text="{local:T 'STATUS UT (F.EKS. TIL COMPANION)'}" Style="{StaticResource SectionHeader}" />
                        <CheckBox x:Name="FbEnabledBox" Content="{local:T 'Send status: neste cue, hva som spiller, tid igjen'}" Margin="0,4,0,0" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Label}" Text="{local:T 'Mottaker (IP)'}" />
                                <TextBox x:Name="FbHostBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Label}" Text="{local:T 'Port'}" />
                                <TextBox x:Name="FbPortBox" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Label}" Text="{local:T 'Format'}" />
                        <ComboBox x:Name="FbFormatBox" ItemsSource="{x:Static local:EnumValues.FeedbackFormats}" ItemTemplate="{StaticResource EnumItem}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="{local:T 'Companion: setter egendefinerte variabler (Custom Variables) via Companions OSC-port (standard 12321, slås på under Settings → Protocols). Opprett variablene i Companion først: sc_next_name, sc_next_number, sc_playing, sc_remaining, sc_state m.fl. – se README. Bruk dem i knappetekst som $(internal:custom_sc_next_name).'}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="{local:T 'Generisk: /showcue/next/name, /showcue/remaining … og /showcue/cue/\{nr\}/running 1/0 – for moduler/programmer som lytter på OSC.'}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= MIDI ================= -->
            <TabItem Header="{local:T 'MIDI inn'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource Page}">
                        <TextBlock Style="{StaticResource Label}" Text="{local:T 'MIDI-inngang'}" />
                        <ComboBox x:Name="MidiInBox" />
                        <TextBlock Style="{StaticResource Label}" Text="{local:T 'Kanal'}" />
                        <ComboBox x:Name="MidiChannelBox" DisplayMemberPath="Value" SelectedValuePath="Key" />

                        <TextBlock Style="{StaticResource Label}" Text="{local:T 'Faste funksjoner'}" Margin="0,14,0,3" />
                        <Grid x:Name="MidiMapGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" x:Name="LearnHint"
                                   Text="{local:T '«Lær»: klikk, og trykk en tast/knapp på kontrolleren. Lær bruker inngangen som er aktiv nå – bytter du inngang, trykk OK og åpne innstillingene igjen først. Hver cue kan også få sin egen MIDI-trigger i panelet til høyre i hovedvinduet.'}" />

                        <CheckBox x:Name="MtcInBox" Content="{local:T 'Ta imot MIDI Time Code (starter cuer med tidskode-trigger)'}" Margin="0,14,0,0" />
                        <CheckBox x:Name="MscBox" Content="{local:T 'Ta imot MIDI Show Control (MSC GO / STOP med cuenummer)'}" Margin="0,8,0,0" />
                        <TextBlock Style="{StaticResource Label}" Text="{local:T 'MSC device ID (127 = alle)'}" />
                        <TextBox x:Name="MscIdBox" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= UTSEENDE ================= -->
            <TabItem Header="{local:T 'Utseende'}">
                <StackPanel Style="{StaticResource Page}">
                    <TextBlock Style="{StaticResource Label}" Text="Språk / Language" />
                    <ComboBox x:Name="LanguageBox" Width="260" HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="{local:T 'Tar effekt neste gang ShowCue startes.'}" />

                    <TextBlock Style="{StaticResource Label}" Text="{local:T 'Fargetema'}" />
                    <ComboBox x:Name="ThemeBox" ItemsSource="{x:Static local:EnumValues.Themes}" ItemTemplate="{StaticResource EnumItem}"
                              SelectionChanged="Theme_Changed" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="{local:T 'Mørk passer de fleste kontrollrom. Grå er et dempet, lyst tema som er mindre hvitt enn Lys. Lys er lettest å lese i dagslys og på prøver. Nattmodus er ekstra dempet for mørke scener og sidescene. Temaet byttes med en gang, også fra Oppsett-menyen.'}" />

                    <TextBlock Style="{StaticResource Label}" Text="{local:T 'Zoom'}" />
                    <ComboBox x:Name="ZoomBox" Width="120" HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="{local:T 'Gjør tekst, knapper og cuelista i hovedvinduet større eller mindre. Også med Ctrl og + / − (eller Oppsett-menyen). Fint på store skjermer, for lang avstand til skjermen eller små bærbare.'}" />

                    <TextBlock Style="{StaticResource Label}" Text="{local:T 'Tekst i cuelista'}" />
                    <ComboBox x:Name="ListScaleBox" Width="120" HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="{local:T 'Gjør bare cuelista større, i tillegg til zoom – lettere å lese under forestilling.'}" />
                </StackPanel>
            </TabItem>

            <!-- ================= SIKKERHET ================= -->
            <TabItem Header="{local:T 'Sikkerhet'}">
                <StackPanel Style="{StaticResource Page}">
                    <TextBlock Style="{StaticResource Label}" Text="{local:T 'Stopp alt: fade-tid (s)'}" />
                    <TextBox x:Name="PanicBox" />
                    <TextBlock Style="{StaticResource Label}" Text="{local:T 'Dobbel-GO-sperre (ms)'}" />
                    <TextBox x:Name="DoubleGoBox" />
                    <TextBlock Style="{StaticResource Hint}" Text="{local:T 'GO ignoreres hvis det kommer innen denne tiden etter forrige GO (prell på tast eller kontroller).'}" />
                    <TextBlock Style="{StaticResource Label}" Text="{local:T 'Mål for «Normaliser lydstyrke» (LUFS)'}" />
                    <TextBox x:Name="LoudnessBox" />
                    <TextBlock Style="{StaticResource Hint}" Text="{local:T '−23 er EBU R128 (kringkasting). Lavere tall = svakere. Alle lyd-cuer som normaliseres får samme opplevde lydstyrke.'}" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
